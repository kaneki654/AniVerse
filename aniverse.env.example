# Copy to .aniverse_env (kept out of git); start_all.sh reads it on every start.
# Every line is optional: a feature stays switched off until its key is set.

# Publish the tunnel's address to discovery/host.json on GitHub at each start,
# so phones find the server by themselves. Needs `gh auth login` once.
export ANIVERSE_PUBLISH_GIT=1

# The server's public address, if it has a fixed one (a named tunnel sets this
# in .aniverse_tunnel instead). Used for the MyAnimeList sign-in return link.
# export ANIVERSE_PUBLIC_URL="https://anime.example.com"

# --- AniList tracking --------------------------------------------------------
# https://anilist.co/settings/developer -> Create new client.
#   Redirect URL: https://anilist.co/api/v2/oauth/pin
# export ANIVERSE_ANILIST_CLIENT_ID="12345"

# --- MyAnimeList tracking -----------------------------------------------------
# https://myanimelist.net/apiconfig -> Create ID. App type: web.
#   App Redirect URL: <your public address>/api/tracking/mal/callback
#   (a quick tunnel's address changes on every start; use a named tunnel)
# export ANIVERSE_MAL_CLIENT_ID="..."
# export ANIVERSE_MAL_CLIENT_SECRET="..."

# --- Google sign-in -----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials -> OAuth client ID ->
# Web application. Authorized JavaScript origins: your public address.
# The same Web client ID serves the app and the website.
# export ANIVERSE_GOOGLE_CLIENT_ID="....apps.googleusercontent.com"

# --- Web push (new-episode alerts on the website with it closed) -------------
# Nothing to set: the keys are made on first start, in data/vapid.pem.
# export ANIVERSE_PUSH_CONTACT="mailto:you@example.com"

# --- Housekeeping ---------------------------------------------------------------
# How many old APKs to keep in data/releases besides the published one
# (default 5). 0 keeps every build.
# export ANIVERSE_KEEP_APKS=5
