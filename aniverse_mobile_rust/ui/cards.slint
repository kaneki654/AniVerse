// Posters, rows, resume cards and the spotlight: lib/ui_manga/widgets/
// poster_card.dart, continue_watching.dart and hero_spotlight.dart.
import { Theme, Label, Body, Heading } from "theme.slint";
import { Icons } from "icons.slint";
import { Tex, Lines, Glyph, PanelBox, Press, InkButton, Chip, InkBar, Skeleton, Cover, PlayBox, SectionHeader, Bubble, Starburst, Clamp } from "ink.slint";
import { Anime, Resume, Slide, Actions } from "store.slint";

// PosterCard: the cover in a thick ink frame with a hard shadow, the score as
// a starburst on its corner, the title lettered under it (always two lines).
export component PosterCard {
    in property <Anime> anime;
    in property <length> title-height: 37px;
    callback clicked();
    Press {
        width: root.width;
        height: root.height;
        clicked => { root.clicked(); }
        Rectangle {
            vertical-stretch: 1;
            PanelBox {
                width: parent.width;
                height: parent.height;
                shadow: 4px;
                border: 2.5px;
                Cover {
                    source: root.anime.cover;
                    has-url: root.anime.cover-url != "";
                }
            }
            if root.anime.score != "": Starburst {
                x: parent.width - 28px;
                y: -8px;
                score: root.anime.score;
            }
        }
        Rectangle { height: 8px; }
        Rectangle {
            height: root.title-height;
            Clamp {
                y: 0;
                width: parent.width;
                text: root.anime.title;
                lines: 2;
                size: Theme.label(8.6);
                weight: 700;
                spacing: 0.3px;
            }
        }
    }
}

// AnimeListRow: small cover, title, score, episodes and status.
export component AnimeRow {
    in property <Anime> anime;
    callback clicked();
    height: 96px;
    Press {
        width: root.width;
        height: root.height;
        clicked => { root.clicked(); }
        PanelBox {
            HorizontalLayout {
                Rectangle {
                    width: 64px;
                    Cover {
                        width: parent.width - 2.5px;
                        source: root.anime.cover;
                        has-url: root.anime.cover-url != "";
                    }
                    Rectangle {
                        x: parent.width - 2.5px;
                        width: 2.5px;
                        background: Theme.line;
                    }
                }
                Rectangle { width: 12px; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 6px;
                    Clamp {
                        text: root.anime.title;
                        lines: 2;
                        size: Theme.heading(16);
                        family: Theme.title-font;
                        weight: 900;
                        line-k: 1.21;
                    }
                    Label {
                        text: root.anime.meta;
                        size: 7;
                        color: Theme.gray;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    padding-right: 8px;
                    padding-left: 4px;
                    Glyph {
                        icon: Icons.chevron;
                        size: 22px;
                    }
                }
            }
        }
    }
}

// The Continue Watching card: the cover with a red play square, the episode
// in a chip and how far in as a bar along the foot.
export component ResumeCard {
    in property <Resume> item;
    callback clicked();
    Press {
        width: root.width;
        height: root.height;
        clicked => { root.clicked(); }
        Rectangle {
            vertical-stretch: 1;
            PanelBox {
                width: parent.width;
                height: parent.height;
                fill: Theme.ink;
                shadow: 3px;
                Rectangle {
                    Cover {
                        source: root.item.cover;
                        has-url: root.item.cover-url != "";
                    }
                    PlayBox {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    Chip {
                        x: 4px;
                        y: parent.height - 12px - self.height;
                        width: self.preferred-width;
                        height: self.preferred-height;
                        text: "EP \{root.item.episode}";
                    }
                    InkBar {
                        y: parent.height - 8px;
                        width: parent.width;
                        height: 8px;
                        fraction: root.item.fraction;
                    }
                }
            }
        }
        Rectangle { height: 6px; }
        Rectangle {
            height: 34px;
            Clamp {
                y: 0;
                width: parent.width;
                text: root.item.title;
                lines: 2;
                size: Theme.text(13);
            }
        }
    }
}

// A titled, sideways-scrolling row of posters.
export component PosterRow {
    in property <string> title;
    in property <[Anime]> items;
    in property <length> pitch: 130px;
    in property <length> row-height: 210px;
    in property <bool> more: false;
    callback opened(string);
    callback more-clicked();
    VerticalLayout {
        SectionHeader {
            title: root.title;
            more: root.more;
            more-clicked => { root.more-clicked(); }
        }
        Flickable {
            height: root.row-height;
            viewport-width: max(self.width, root.items.length * root.pitch);
            viewport-height: root.row-height;
            for anime[i] in root.items: PosterCard {
                x: i * root.pitch;
                y: 8px;
                width: root.pitch - 14px;
                height: root.row-height - 8px;
                anime: anime;
                clicked => { root.opened(anime.id); }
            }
        }
    }
}

// Placeholder row while a home section loads.
export component SectionSkeleton {
    height: 214px;
    for i in 4: VerticalLayout {
        x: i * 130px;
        y: 8px;
        width: 116px;
        height: root.height - 8px;
        spacing: 8px;
        PanelBox {
            vertical-stretch: 1;
            shadow: 4px;
            Skeleton { }
        }
        HorizontalLayout {
            alignment: start;
            Skeleton {
                width: 96px;
                height: 10px;
            }
        }
    }
}

// One page of the spotlight: the cover cut into a slanted panel, the title
// lettered over screentone with focus lines behind it, the episode news in a
// speech bubble.
component SlideView {
    in property <Slide> slide;
    in property <float> flash;
    callback opened();
    Press {
        x: 2px;
        y: 2px;
        width: root.width - 10px;
        height: root.height - 8px;
        clicked => { root.opened(); }
        PanelBox {
            border: 3px;
            shadow: 5px;
            Rectangle {
                clip: true;
                if Theme.manga: Image {
                    width: parent.width;
                    height: parent.height;
                    source: Tex.hero-ground;
                    image-fit: ImageFit.fill;
                }
                // Focus lines that flicker as a page lands, then fade to a faint pattern.
                if Theme.manga: Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: Lines.hero-w / 1px;
                    viewbox-height: Lines.hero-h / 1px;
                    commands: Lines.hero;
                    fill: #121010.with-alpha(0.133 + 0.467 * root.flash);
                }
                Image {
                    x: 0;
                    y: 0;
                    width: 150px;
                    height: parent.height;
                    source: root.slide.cover;
                    image-fit: ImageFit.fill;
                }
                Path {
                    x: 0;
                    y: 0;
                    width: 150px;
                    height: parent.height;
                    viewbox-width: 150;
                    viewbox-height: self.height / 1px;
                    stroke: Theme.line;
                    stroke-width: 3.5px;
                    commands: "M 150 0 L 122 \{self.height / 1px}";
                }
                VerticalLayout {
                    x: 144px;
                    y: 12px;
                    width: parent.width - 156px;
                    height: parent.height - 24px;
                    alignment: center;
                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            width: tag.preferred-width + 16px;
                            height: tag.preferred-height + 6px;
                            property <float> w: self.width / 1px;
                            property <float> h: self.height / 1px;
                            Path {
                                width: parent.width;
                                height: parent.height;
                                viewbox-width: parent.w;
                                viewbox-height: parent.h;
                                fill: Theme.red;
                                // the box turned by -0.05 rad about its centre
                                commands: "M \{parent.w / 2 - parent.w / 2 * 0.99875 - parent.h / 2 * 0.04998} \{parent.h / 2 + parent.w / 2 * 0.04998 - parent.h / 2 * 0.99875} "
                                    + "L \{parent.w / 2 + parent.w / 2 * 0.99875 - parent.h / 2 * 0.04998} \{parent.h / 2 - parent.w / 2 * 0.04998 - parent.h / 2 * 0.99875} "
                                    + "L \{parent.w / 2 + parent.w / 2 * 0.99875 + parent.h / 2 * 0.04998} \{parent.h / 2 - parent.w / 2 * 0.04998 + parent.h / 2 * 0.99875} "
                                    + "L \{parent.w / 2 - parent.w / 2 * 0.99875 + parent.h / 2 * 0.04998} \{parent.h / 2 + parent.w / 2 * 0.04998 + parent.h / 2 * 0.99875} Z";
                            }
                            tag := Label {
                                x: 8px;
                                y: 3px;
                                text: "SPOTLIGHT";
                                size: 7;
                                color: Theme.white;
                                rotation-angle: -2.86deg;
                            }
                        }
                    }
                    Rectangle { height: 8px; }
                    Clamp {
                        text: root.slide.title;
                        lines: 3;
                        size: Theme.heading(19);
                        family: Theme.title-font;
                        weight: 900;
                        line-k: 1.21;
                        stroke: Theme.manga ? Theme.white : transparent;
                        stroke-width: 2px;
                    }
                    Rectangle { height: 4px; }
                    if root.slide.meta != "": HorizontalLayout {
                        alignment: start;
                        Bubble {
                            tail-x: -0.6;
                            pad-left: 10px;
                            pad-right: 10px;
                            pad-top: 4px;
                            pad-bottom: 16px;
                            Body {
                                text: root.slide.meta;
                                size: 13;
                            }
                        }
                    }
                    Rectangle { height: 6px; }
                    HorizontalLayout {
                        alignment: start;
                        InkButton {
                            label: "WATCH NOW";
                            icon: Icons.play;
                            size: 8;
                            clicked => { root.opened(); }
                        }
                    }
                }
            }
        }
    }
}

// The swipeable spotlight for the top trending shows. Turning to the next
// show flashes the focus lines and jolts the panel; the page number sits under
// it like a manga page's folio.
export component Spotlight {
    in property <[Slide]> slides;
    callback opened(string);
    property <int> page: 0;
    property <float> from: 0;
    property <float> to: 0;
    property <float> t: 1;
    property <float> drag: 0;
    property <bool> turned: false;
    property <float> flash: 0;
    property <int> shake: 0;
    property <float> pos: self.t >= 1 ? self.page : self.from + (self.to - self.from) * (1 - pow(1 - self.t, 3));
    property <length> jolt-x: self.shake > 0 && Theme.fx == 2 ? (sin(self.shake * 744.26deg) * 43758.5453 - floor(sin(self.shake * 744.26deg) * 43758.5453) - 0.5) * 8px * self.shake / 24 : 0px;
    property <length> jolt-y: self.shake > 0 && Theme.fx == 2 ? (sin((self.shake + 31) * 744.26deg) * 43758.5453 - floor(sin((self.shake + 31) * 744.26deg) * 43758.5453) - 0.5) * 8px * self.shake / 24 : 0px;
    min-height: col.min-height;
    preferred-height: col.preferred-height;
    Timer {
        interval: 16ms;
        running: root.t < 1 || root.flash > 0 || root.shake > 0;
        triggered => {
            if root.t < 1 {
                root.t = min(1, root.t + 0.055);
                if root.t >= 1 && root.turned {
                    root.turned = false;
                    if Theme.fx > 0 { root.flash = 1; }
                    if Theme.fx == 2 { root.shake = 24; }
                }
            } else {
                root.flash = max(0, root.flash - 0.031);
                root.shake = max(0, root.shake - 1);
            }
        }
    }
    col := VerticalLayout {
        spacing: 10px;
        area := Rectangle {
            height: 236px;
            clip: true;
            swipe := SwipeGestureHandler {
                handle-swipe-left: root.page < root.slides.length - 1;
                handle-swipe-right: root.page > 0;
                swiped => {
                    root.drag = (self.current-position.x - self.pressed-position.x) / area.width;
                    root.from = root.page - root.drag;
                    root.turned = (root.drag < -0.12 && root.page < root.slides.length - 1) || (root.drag > 0.12 && root.page > 0);
                    root.page = root.drag < -0.12 ? min(root.page + 1, root.slides.length - 1) : root.drag > 0.12 ? max(root.page - 1, 0) : root.page;
                    root.to = root.page;
                    root.t = 0;
                    if root.turned { Actions.sfx("slash"); }
                }
                cancelled => {
                    root.from = root.page;
                    root.to = root.page;
                    root.t = 1;
                }
                for slide[i] in root.slides: SlideView {
                    x: (i - root.pos) * area.width + (swipe.swiping ? swipe.current-position.x - swipe.pressed-position.x : 0px) + root.jolt-x;
                    y: root.jolt-y;
                    width: area.width;
                    height: area.height;
                    slide: slide;
                    flash: i == root.page ? root.flash : 0;
                    opened => { root.opened(slide.id); }
                }
            }
        }
        if root.slides.length > 1: Label {
            text: "—  \{root.page + 1} / \{root.slides.length}  —";
            size: 8;
            color: Theme.gray;
            horizontal-alignment: center;
        }
    }
}

// Placeholder shaped like the spotlight while the home data loads.
export component SpotlightSkeleton {
    VerticalLayout {
        spacing: 10px;
        PanelBox {
            height: 236px;
            border: 3px;
            shadow: 5px;
            Skeleton { }
        }
        Label {
            text: "—  1 / 5  —";
            size: 8;
            color: Theme.gray-light;
            horizontal-alignment: center;
        }
    }
}
